{
  "$schema": null,
  "productName": "spotify-lyrics-overlay",
  "version": "0.1.0",
  "identifier": "com.gaga.spotify-lyrics-overlay",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lyrics Overlay",
        "width": 480,
        "height": 350,
        "minWidth": 480,
        "minHeight": 350,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.spotify.com https://lrclib.net https://open.spotify.com https://spclient.wg.spotify.com https://accounts.spotify.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.scdn.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {}
  }
}
